{
  "schema": "tavi.extension/v1",
  "id": "example.org.registry-admin",
  "version": "0.1.0",
  "name": "Registry Admin Request Example",
  "summary": "Contract fixture only; no privileged runtime implementation.",
  "publisher": "example-org",
  "kind": "app",
  "hostApi": {
    "min": "1.0.0",
    "maxExclusive": "2.0.0"
  },
  "entrypoints": {
    "panel": "ui/index.html"
  },
  "contributions": [
    {
      "slot": "app.launcher",
      "id": "registry-admin-example",
      "label": "Admin Contract",
      "action": "openPanel"
    }
  ],
  "permissions": [
    "ui.panel",
    "assets.registry.admin/v1"
  ],
  "platforms": [
    "web",
    "windows",
    "android"
  ]
}
