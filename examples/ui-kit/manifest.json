{
  "schema": "tavi.extension/v1",
  "id": "example.org.tavi-ui-kit",
  "version": "0.1.1",
  "name": "Tavi UI Kit",
  "summary": "Offline, responsive Tavi icon/typography reference; optional host theme integration.",
  "publisher": "example-org",
  "kind": "app",
  "icon": "ui/icon.svg",
  "hostApi": {
    "min": "1.0.0",
    "maxExclusive": "2.0.0"
  },
  "entrypoints": {
    "panel": "ui/index.html"
  },
  "contributions": [
    {
      "slot": "app.launcher",
      "id": "ui-kit",
      "label": "Tavi UI Kit",
      "action": "openPanel"
    }
  ],
  "permissions": [
    "ui.panel"
  ],
  "platforms": [
    "web",
    "windows",
    "android"
  ]
}
