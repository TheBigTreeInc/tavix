{
  "schema": "tavi.extension/v1",
  "id": "example.org.tavix-store-editor",
  "version": "0.1.1",
  "name": "TaviX Store Editor",
  "summary": "Preview and edit TaviX Store listings offline before submitting reviewed packages for publication.",
  "publisher": "example-org",
  "kind": "app",
  "hostApi": {
    "min": "1.0.0",
    "maxExclusive": "2.0.0"
  },
  "entrypoints": {
    "panel": "ui/index.html"
  },
  "contributions": [
    {
      "slot": "app.launcher",
      "id": "store-editor",
      "label": "Store Editor",
      "action": "openPanel"
    }
  ],
  "permissions": [
    "ui.panel"
  ],
  "platforms": [
    "web",
    "windows",
    "android"
  ],
  "icon": "ui/icon.svg"
}
