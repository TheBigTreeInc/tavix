# Integrity hashes are computed from exact publisher bytes: never normalize
# compiled extension assets, manifests, lockfiles or release metadata.
extensions/** -text
*.tavix binary
*.png binary
*.webp binary
# The catalog itself is regenerated deterministically and checked on Windows.
tavi.repository.json text eol=lf
architecture/c4/*.dsl text eol=lf
architecture/c4/*.adoc text eol=lf

# Developer contract documentation and machine-readable integration snapshot.
docs/*.adoc text eol=lf
contracts/*.json text eol=lf
examples/hello-tavix/** text eol=lf
