{
  "schema": "tavi.extension/v1",
  "id": "inc.thebigtree.tavi.klondike",
  "version": "0.1.1",
  "name": "Klondike Solitaire",
  "summary": "A fully offline Klondike card game. No network, no account, no advertising, no purchases.",
  "publisher": "thebigtreeinc",
  "kind": "app",
  "classification": {
    "type": "game",
    "categories": [
      "cards",
      "solitaire"
    ]
  },
  "hostApi": {
    "min": "1.0.0",
    "maxExclusive": "2.0.0"
  },
  "entrypoints": {
    "panel": "ui/index.html"
  },
  "contributions": [
    {
      "slot": "app.launcher",
      "id": "klondike",
      "label": "Klondike Solitaire",
      "action": "openPanel"
    }
  ],
  "permissions": [
    "ui.panel",
    "storage.private"
  ],
  "platforms": [
    "web",
    "android",
    "windows"
  ],
  "icon": "ui/icon.png"
}
