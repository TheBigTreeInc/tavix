{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebigtreeinc.github.io/tavix/contracts/tavix-local-file-request-v1.schema.json",
  "title": "TaviX local-file host requests",
  "description": "Request envelopes. The host must also enforce manifest-filter subsets, user gesture, session and file-size limits; schemas alone are not authorization.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "direction",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "channel": {
          "const": "tavi.extension/v1"
        },
        "direction": {
          "const": "request"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "const": "files.local.pick"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accept",
            "maxBytes"
          ],
          "properties": {
            "accept": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "extensions",
                "mimeTypes"
              ],
              "properties": {
                "extensions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^\\.[a-z0-9]{1,12}$"
                  }
                },
                "mimeTypes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
                  }
                }
              }
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "direction",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "channel": {
          "const": "tavi.extension/v1"
        },
        "direction": {
          "const": "request"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "const": "files.local.read"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle",
            "offset",
            "length"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "direction",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "channel": {
          "const": "tavi.extension/v1"
        },
        "direction": {
          "const": "request"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "const": "files.local.close"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "direction",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "channel": {
          "const": "tavi.extension/v1"
        },
        "direction": {
          "const": "request"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "const": "files.local.cancel"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetRequestId"
          ],
          "properties": {
            "targetRequestId": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  ]
}
