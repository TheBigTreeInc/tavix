{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebigtreeinc.github.io/tavix/contracts/tavix-local-file-import-v1.schema.json",
  "title": "TaviX optional manifest.fileImports request (not a grant)",
  "description": "Applies to manifest.fileImports only. Requires the separate files.local.import permission and ui.panel; host verifies manifest and session. Missing field and permission is the legacy default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extensions",
    "mimeTypes",
    "maxBytes"
  ],
  "properties": {
    "extensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-z0-9]{1,12}$"
      }
    },
    "mimeTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
      }
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    }
  }
}
